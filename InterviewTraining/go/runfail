#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT_DIR"

# Ensure color-capable programs emit ANSI even when wrappers or pipes are used.
# This forces most Node/Go/Python color libraries to output color sequences.
export FORCE_COLOR=1
export TERM=${TERM:-xterm-256color}

MODULES=(
  3sum
  bstTraverse
  firstDuplicateValue
  longestPeak
  isMonotonic
  minHeightBst
  bstInsertRemove
  branchSums
  findThreeLargestNumbers
  validateBst
)

for m in "${MODULES[@]}"; do
  echo "========================================"
  echo "Running solution tests for: $m"
  sol="solutions/${m}.go"
  if [ ! -f "$sol" ]; then
    echo "  No solution file found at $sol — skipping"
    continue
  fi

  (cd solutions && if ! go run -tags=problem testrun_solution.go "${m}.go" -- "$m"; then
    echo "Tests for $m failed (or runner errored)"
  fi)

done

echo "Done."
